{
  "id": "app.uninstall",
  "version": "1.0.0",
  "name": "Uninstall approved application",
  "description": "Uninstall one prevalidated non-system application using a short-lived scoped approval, then verify the package is absent.",
  "kind": "deterministic",
  "input_schema": "contracts/schemas/app-removal-approval.schema.json",
  "output_schema": "contracts/schemas/app-removal-result.schema.json",
  "required_capabilities": ["app.uninstall@1", "app.inspect@1"],
  "tool_allowlist": ["app.uninstall", "app.inspect", "app.list"],
  "risk": "high",
  "timeout_seconds": 180,
  "max_steps": 2,
  "verification": "package_manager_post_uninstall_absence"
}
