{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobile-agent.local/schemas/ui-node/v1.json",
  "title": "UiNode",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "node_id", "parent_id", "depth", "text", "resource_id", "content_description", "class_name", "package", "clickable", "enabled", "visible", "bounds"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "node_id": { "type": "string" },
    "parent_id": { "type": ["string", "null"] },
    "depth": { "type": "integer", "minimum": 0, "maximum": 64 },
    "text": { "type": "string", "maxLength": 1024 },
    "resource_id": { "type": "string", "maxLength": 1024 },
    "content_description": { "type": "string", "maxLength": 1024 },
    "class_name": { "type": "string", "maxLength": 1024 },
    "package": { "type": "string", "maxLength": 1024 },
    "clickable": { "type": "boolean" },
    "enabled": { "type": "boolean" },
    "visible": { "type": "boolean" },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left", "top", "right", "bottom"],
      "properties": {
        "left": { "type": "integer", "minimum": 0 },
        "top": { "type": "integer", "minimum": 0 },
        "right": { "type": "integer", "minimum": 1 },
        "bottom": { "type": "integer", "minimum": 1 }
      }
    }
  }
}

