{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobile-agent.local/schemas/observation/v1.json",
  "title": "Observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observation_id",
    "device_id",
    "captured_at",
    "foreground_app",
    "screen",
    "ui_tree",
    "device_state"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "observation_id": { "type": "string", "pattern": "^obs_[a-f0-9]{32}$" },
    "device_id": { "type": "string", "minLength": 1 },
    "captured_at": { "type": "string", "format": "date-time" },
    "foreground_app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["app_id", "activity", "captured_at"],
      "properties": {
        "app_id": { "type": "string" },
        "activity": { "type": "string" },
        "captured_at": { "type": "string", "format": "date-time" }
      }
    },
    "screen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "orientation", "captured_at", "screenshot"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "orientation": { "enum": ["portrait", "landscape", "square"] },
        "captured_at": { "type": "string", "format": "date-time" },
        "screenshot": { "$ref": "artifact.schema.json" }
      }
    },
    "ui_tree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["captured_at", "artifact"],
      "properties": {
        "captured_at": { "type": "string", "format": "date-time" },
        "artifact": { "$ref": "artifact.schema.json" }
      }
    },
    "device_state": { "enum": ["interactive", "locked", "unknown"] }
  }
}

