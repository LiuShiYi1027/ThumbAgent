{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobile-agent.local/schemas/agent-evaluation-scenario/v1.json",
  "title": "AgentEvaluationScenario",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scenario_id", "goal", "acceptance", "forbidden_tools", "max_rounds"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "scenario_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,119}$" },
    "goal": { "type": "string", "minLength": 1, "maxLength": 500 },
    "acceptance": { "$ref": "agent-goal-acceptance.schema.json" },
    "forbidden_tools": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 50,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$" }
    },
    "max_rounds": { "type": "integer", "minimum": 1, "maximum": 50 }
  }
}
