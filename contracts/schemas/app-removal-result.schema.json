{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobile-agent.local/schemas/app-removal-result.schema.json",
  "title": "Application Removal Result",
  "type": "object",
  "required": ["schema_version", "skill_call_id", "skill_id", "skill_version", "device_id", "success", "status", "verification", "removed_app", "data_retained", "evidence_refs", "started_at", "completed_at"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "skill_call_id": { "type": "string" },
    "skill_id": { "const": "app.uninstall" },
    "skill_version": { "const": "1.0.0" },
    "device_id": { "type": "string" },
    "success": { "const": true },
    "status": { "const": "succeeded" },
    "verification": { "const": "verified" },
    "removed_app": { "$ref": "app-inspection-result.schema.json" },
    "data_retained": { "type": "boolean" },
    "evidence_refs": { "type": "array", "maxItems": 0 },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
