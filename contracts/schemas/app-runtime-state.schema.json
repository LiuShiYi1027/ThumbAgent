{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobile-agent.local/schemas/app-runtime-state.schema.json",
  "title": "Application Runtime State",
  "type": "object",
  "required": ["schema_version", "device_id", "app", "process_present", "foreground", "stopped", "observed_at"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "device_id": { "type": "string" },
    "app": { "$ref": "app-inspection-result.schema.json" },
    "process_present": { "type": "boolean" },
    "foreground": { "type": "boolean" },
    "stopped": { "type": ["boolean", "null"] },
    "observed_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
