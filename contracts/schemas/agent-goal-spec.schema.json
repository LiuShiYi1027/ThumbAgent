{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobile-agent.local/schemas/agent-goal-spec/v1.json",
  "title": "AgentGoalSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_goal", "execution_goal", "assumptions", "confidence", "compiler_id", "source", "confirmation_required"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "source_goal": { "type": "string", "minLength": 1, "maxLength": 500 },
    "execution_goal": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "acceptance": { "$ref": "agent-goal-acceptance.schema.json" },
    "assumptions": {
      "type": "array",
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "compiler_id": { "type": "string", "minLength": 1, "maxLength": 120 },
    "source": { "enum": ["rule", "llm"] },
    "confirmation_required": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": { "properties": { "source": { "const": "llm" } }, "required": ["source"] },
      "then": { "properties": { "confirmation_required": { "const": true } } }
    }
  ]
}
