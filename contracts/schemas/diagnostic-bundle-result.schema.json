{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobile-agent.local/schemas/diagnostic-bundle-result.schema.json",
  "title": "Diagnostic Bundle Result",
  "type": "object",
  "required": ["schema_version", "skill_call_id", "skill_id", "skill_version", "device_id", "success", "status", "verification", "app_state", "foreground_app", "log_summary", "performance_summary", "source_artifacts", "bundle_artifact", "evidence_refs", "started_at", "completed_at"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "skill_call_id": { "type": "string", "pattern": "^skillcall_[a-f0-9]{32}$" },
    "skill_id": { "const": "device.diagnostics.bundle" },
    "skill_version": { "const": "1.0.0" },
    "device_id": { "type": "string" },
    "success": { "const": true },
    "status": { "const": "succeeded" },
    "verification": { "const": "verified" },
    "app_state": { "oneOf": [{ "$ref": "app-runtime-state.schema.json" }, { "type": "null" }] },
    "foreground_app": { "type": "object" },
    "log_summary": {
      "type": "object",
      "required": ["minimum_level", "captured_bytes", "truncated", "redaction_count"],
      "properties": {
        "minimum_level": { "type": "string" },
        "captured_bytes": { "type": "integer", "minimum": 1 },
        "truncated": { "type": "boolean" },
        "redaction_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "performance_summary": { "type": "object" },
    "source_artifacts": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "artifact.schema.json" } },
    "bundle_artifact": { "$ref": "artifact.schema.json" },
    "evidence_refs": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "type": "string" } },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
