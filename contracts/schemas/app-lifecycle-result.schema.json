{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobile-agent.local/schemas/app-lifecycle-result.schema.json",
  "title": "Application Lifecycle Result",
  "type": "object",
  "required": ["schema_version", "skill_call_id", "skill_id", "skill_version", "device_id", "operation", "success", "status", "verification", "app", "state", "data_cleared", "evidence_refs", "started_at", "completed_at"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "skill_call_id": { "type": "string" },
    "skill_id": { "enum": ["app.open", "app.stop", "app.data.clear"] },
    "skill_version": { "const": "1.0.0" },
    "device_id": { "type": "string" },
    "operation": { "enum": ["launch", "stop", "clear_data"] },
    "success": { "const": true },
    "status": { "const": "succeeded" },
    "verification": { "const": "verified" },
    "app": { "$ref": "app-inspection-result.schema.json" },
    "state": { "$ref": "app-runtime-state.schema.json" },
    "data_cleared": { "type": ["boolean", "null"] },
    "evidence_refs": { "type": "array", "maxItems": 0 },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
