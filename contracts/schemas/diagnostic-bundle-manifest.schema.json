{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobile-agent.local/schemas/diagnostic-bundle-manifest.schema.json",
  "title": "Diagnostic Bundle Manifest",
  "type": "object",
  "required": ["schema_version", "device_id", "captured_at", "foreground_app", "app_state", "entries"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "device_id": { "type": "string" },
    "captured_at": { "type": "string", "format": "date-time" },
    "foreground_app": { "type": "object" },
    "app_state": { "oneOf": [{ "$ref": "app-runtime-state.schema.json" }, { "type": "null" }] },
    "entries": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["name", "artifact_id", "kind", "size_bytes", "sha256"],
        "properties": {
          "name": { "enum": ["screenshot.png", "ui-tree.xml", "device.log", "performance.json"] },
          "artifact_id": { "type": "string" },
          "kind": { "type": "string" },
          "size_bytes": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
