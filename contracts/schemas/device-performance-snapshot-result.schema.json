{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobile-agent.local/schemas/device-performance-snapshot-result/v1.json",
  "title": "Device Performance Snapshot Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "skill_call_id", "skill_id", "skill_version", "device_id",
    "success", "status", "verification", "snapshot", "evidence_refs", "artifact",
    "started_at", "completed_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "skill_call_id": { "type": "string", "pattern": "^skillcall_[a-f0-9]{32}$" },
    "skill_id": { "const": "device.performance.snapshot" },
    "skill_version": { "const": "1.0.0" },
    "device_id": { "type": "string", "minLength": 1 },
    "success": { "const": true },
    "status": { "const": "succeeded" },
    "verification": { "const": "verified" },
    "snapshot": { "$ref": "device-performance-snapshot.schema.json" },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "type": "string", "pattern": "^artifact_[a-f0-9]{32}$" }
    },
    "artifact": { "$ref": "artifact.schema.json" },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" }
  }
}
