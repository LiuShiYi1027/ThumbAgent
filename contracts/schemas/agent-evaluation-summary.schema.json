{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobile-agent.local/schemas/agent-evaluation-summary/v1.json",
  "title": "AgentEvaluationSummary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite_id", "expected_run_count", "evaluated_run_count", "passed_run_count", "pass_rate", "scenario_results", "metrics", "failure_reasons", "terminal_errors"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "suite_id": { "type": "string", "minLength": 3, "maxLength": 120 },
    "expected_run_count": { "type": "integer", "minimum": 1 },
    "evaluated_run_count": { "type": "integer", "minimum": 1 },
    "passed_run_count": { "type": "integer", "minimum": 0 },
    "pass_rate": { "type": "number", "minimum": 0, "maximum": 1 },
    "scenario_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenario_id", "run_count", "passed_count", "pass_rate"],
        "properties": {
          "scenario_id": { "type": "string" },
          "run_count": { "type": "integer", "minimum": 1 },
          "passed_count": { "type": "integer", "minimum": 0 },
          "pass_rate": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["average_round_count", "average_tool_call_count", "average_duration_ms", "p50_duration_ms", "p95_duration_ms", "total_provider_latency_ms", "total_provider_attempt_count", "total_provider_retry_count", "total_no_progress_count", "total_model_unavailable_count", "total_policy_violation_count"],
      "properties": {
        "average_round_count": { "type": "number", "minimum": 0 },
        "average_tool_call_count": { "type": "number", "minimum": 0 },
        "average_duration_ms": { "type": "integer", "minimum": 0 },
        "p50_duration_ms": { "type": "integer", "minimum": 0 },
        "p95_duration_ms": { "type": "integer", "minimum": 0 },
        "total_provider_latency_ms": { "type": "integer", "minimum": 0 },
        "total_provider_attempt_count": { "type": "integer", "minimum": 0 },
        "total_provider_retry_count": { "type": "integer", "minimum": 0 },
        "total_no_progress_count": { "type": "integer", "minimum": 0 },
        "total_model_unavailable_count": { "type": "integer", "minimum": 0 },
        "total_policy_violation_count": { "type": "integer", "minimum": 0 }
      }
    },
    "failure_reasons": { "$ref": "#/$defs/counts" },
    "terminal_errors": { "$ref": "#/$defs/counts" }
  },
  "$defs": {
    "counts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "count"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "count": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
