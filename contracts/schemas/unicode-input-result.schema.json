{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobile-agent.local/schemas/unicode-input-result/v1.json",
  "title": "Unicode Input Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "skill_call_id",
    "skill_id",
    "skill_version",
    "device_id",
    "success",
    "status",
    "verification",
    "field",
    "text_length",
    "text_sha256",
    "ime",
    "evidence_refs",
    "started_at",
    "completed_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "skill_call_id": { "type": "string", "pattern": "^skillcall_[a-f0-9]{32}$" },
    "skill_id": { "const": "input.unicode_text" },
    "skill_version": { "const": "1.0.0" },
    "device_id": { "type": "string", "minLength": 1 },
    "success": { "const": true },
    "status": { "const": "succeeded" },
    "verification": { "const": "verified" },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector", "package"],
      "properties": {
        "selector": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy", "value", "match"],
          "properties": {
            "strategy": { "type": "string", "minLength": 1 },
            "value": { "type": "string", "minLength": 1, "maxLength": 256 },
            "match": { "type": "string", "minLength": 1 }
          }
        },
        "package": { "type": "string", "minLength": 1 },
        "resource_id": { "type": "string" }
      }
    },
    "text_length": { "type": "integer", "minimum": 1, "maximum": 256 },
    "text_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "ime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["helper_id", "previous_id", "restored"],
      "properties": {
        "helper_id": { "type": "string", "minLength": 1 },
        "previous_id": { "type": "string", "minLength": 1 },
        "restored": { "const": true }
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": { "type": "string", "pattern": "^artifact_[a-f0-9]{32}$" }
    },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "submitted": {
      "const": "search",
      "description": "Present only when the request asked to submit the field IME search action after verified input."
    }
  }
}
