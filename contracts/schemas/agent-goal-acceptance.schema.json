{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobile-agent.local/schemas/agent-goal-acceptance/v1.json",
  "title": "AgentGoalAcceptance",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "foreground_app_id": { "type": "string", "minLength": 1, "maxLength": 255 },
    "foreground_activity": { "type": "string", "minLength": 1, "maxLength": 500 },
    "expected_selector": {
      "allOf": [
        { "$ref": "ui-selector.schema.json" },
        {
          "properties": {
            "resolve_clickable_ancestor": { "const": false },
            "ancestor_path": { "maxItems": 0 }
          }
        }
      ]
    }
  },
  "anyOf": [
    { "required": ["foreground_app_id"] },
    { "required": ["foreground_activity"] },
    { "required": ["expected_selector"] }
  ]
}
