{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobile-agent.local/schemas/app-inspection-request.schema.json",
  "title": "App Inspection Request",
  "type": "object",
  "required": ["device_id", "app_id"],
  "properties": {
    "device_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "app_id": { "type": "string", "pattern": "^[A-Za-z0-9_]+(?:\\.[A-Za-z0-9_]+)+$", "maxLength": 256 }
  },
  "additionalProperties": false
}
